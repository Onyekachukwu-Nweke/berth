# mountabo — single source of truth for local config.
# Copy to .env at the repo root and fill in the GitHub App credentials.
# Read by the Go backend (internal/config) and the Next frontend (next.config.ts).

# ── GitHub App ──
# mountabo is a GitHub App. Create one at https://github.com/settings/apps/new
# (or under your org: Settings → Developer settings → GitHub Apps):
#   Callback URL:  <MOUNTABO_PUBLIC_URL>/api/auth/callback
#                  (local: http://localhost:4321/api/auth/callback)
#   Expire user authorization tokens: on (mountabo refreshes them)
#   Request user authorization during installation: off
#   Webhook: off
#   Repository permissions:
#     Administration: read & write   (deploy keys, environments)
#     Contents:       read & write   (commit the workflow + deploy script)
#     Secrets:        read & write   (environment secrets)
#     Environments:   read & write
#     Workflows:      read & write
#     Actions:        read           (run status and logs)
#     Metadata:       read           (mandatory)
# Then install it on your org and on each client's org, choosing the repos.
# People see exactly the repos they can reach on GitHub where it's installed.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The App's private key (.pem). Paste as one line with \n for newlines, or
# base64 it: base64 -w0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY=
# The App's client id and a client secret generated on the App's page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub logins with full control (servers, clients, environments, terminal).
# Comma separated. Everyone else signs in as a developer.
MOUNTABO_ADMINS=

# ── AI command helper (terminal page) ──
# Anthropic API key for the "ask the AI helper" feature on the terminal page.
# Optional: leave empty to run mountabo without AI suggestions (the terminal
# page then shows a hint to set this). Backend only; never sent to the browser.
# Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for suggestions (default claude-sonnet-4-6).
# MOUNTABO_AI_MODEL=

# ── Wiring ──
# URL the frontend uses to reach the Go backend's exchange endpoint.
MOUNTABO_BACKEND=http://localhost:7778
# Address the Go backend listens on. Loopback for local dev; compose sets ":7778".
MOUNTABO_HTTP_ADDR=127.0.0.1:7778

# The URL people open mountabo at, e.g. https://deploy.example.com. OAuth
# redirects are built from it. Required for a hosted install (compose); local
# dev can leave it unset and uses the request's own origin.
# MOUNTABO_PUBLIC_URL=

# ── Database ──
# Postgres holds all of mountabo's state. Locally, `make db` starts one on
# localhost:5432 with these credentials. In docker compose, DATABASE_URL is
# built from POSTGRES_PASSWORD for you.
POSTGRES_PASSWORD=mountabo
DATABASE_URL=postgres://mountabo:mountabo@localhost:5432/mountabo?sslmode=disable

# ── Vault ──
# Seals the platform's own credentials (server SSH keys, repo deploy keys) in
# the database. App secrets are NOT stored here; they go to GitHub Actions.
# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Back it up: losing it makes every stored server key unreadable.
MOUNTABO_MASTER_KEY=
